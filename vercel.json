{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/interests",
      "permanent": true
    },
    {
      "source": "/portfolio/",
      "destination": "/interests",
      "permanent": true
    },
    {
      "source": "/es/portfolio",
      "destination": "/es/interests",
      "permanent": true
    },
    {
      "source": "/es/portfolio/",
      "destination": "/es/interests",
      "permanent": true
    }
  ]
}
