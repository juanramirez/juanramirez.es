---
interface Props {
  appId: string;
  pageId: string;
  pageUrl: string;
  pageTitle: string;
  heading?: string;
  lang?: string;
}

const { appId, pageId, pageUrl, pageTitle, heading = "Comments", lang = "en" } = Astro.props;
---

<section class="mt-10 border-t border-ink/15 pt-8" id="comments">
  <h2 class="mb-4 font-serif text-2xl">{heading}</h2>
  <div
    id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id={appId}
    data-page-id={pageId}
    data-page-url={pageUrl}
    data-page-title={pageTitle}
    data-lang={lang}
  ></div>
  <script is:inline async defer src="https://cusdis.com/js/cusdis.es.js"></script>
</section>
