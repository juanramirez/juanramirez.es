---
import { switchLocalePath, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const spanishPath = switchLocalePath(Astro.url.pathname, "es");
const englishPath = switchLocalePath(Astro.url.pathname, "en");
---

<div
  id="locale-prompt"
  class="locale-prompt"
  hidden
  data-current-locale={locale}
  data-spanish-path={spanishPath}
  data-english-path={englishPath}
>
  <p>Tu navegador está en español. ¿Prefieres ver esta web en español?</p>
  <div>
    <a href={spanishPath} data-locale-prompt-choice="es">Español</a>
    <button type="button" data-locale-prompt-choice="en">Keep English</button>
  </div>
</div>

<script>
  const prompt = document.getElementById("locale-prompt");

  if (prompt instanceof HTMLElement) {
    const currentLocale = prompt.dataset.currentLocale;
    const preferredLocale = window.localStorage.getItem("preferred-locale");
    const browserLocales = navigator.languages?.length ? navigator.languages : [navigator.language];
    const browserPrefersSpanish = browserLocales.some((language) =>
      language.toLowerCase().startsWith("es")
    );

    if (!preferredLocale && currentLocale === "en" && browserPrefersSpanish) {
      prompt.hidden = false;
    }

    prompt.querySelectorAll("[data-locale-prompt-choice]").forEach((control) => {
      control.addEventListener("click", () => {
        if (!(control instanceof HTMLElement)) return;
        const locale = control.dataset.localePromptChoice;
        if (locale === "en" || locale === "es") {
          window.localStorage.setItem("preferred-locale", locale);
        }

        if (locale === "en") {
          prompt.hidden = true;
        }
      });
    });
  }
</script>

<style>
  .locale-prompt {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: grid;
    max-width: min(22rem, calc(100vw - 2rem));
    gap: 0.75rem;
    border: 1px solid rgb(27 31 35 / 0.15);
    border-radius: 0.5rem;
    background: #fdfaf4;
    padding: 1rem;
    box-shadow: 0 12px 36px rgb(27 31 35 / 0.14);
    color: rgb(27 31 35);
    font-size: 0.95rem;
  }

  .locale-prompt[hidden] {
    display: none;
  }

  .locale-prompt p {
    margin: 0;
  }

  .locale-prompt div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .locale-prompt a,
  .locale-prompt button {
    border: 1px solid rgb(27 31 35 / 0.2);
    border-radius: 0.35rem;
    background: white;
    padding: 0.45rem 0.65rem;
    color: inherit;
    font: inherit;
    line-height: 1;
    text-decoration: none;
  }
</style>
