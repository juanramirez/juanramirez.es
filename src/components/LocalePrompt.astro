---
import { switchLocalePath, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const spanishPath = switchLocalePath(Astro.url.pathname, "es");
const englishPath = switchLocalePath(Astro.url.pathname, "en");
---

<div
  id="locale-prompt"
  hidden
  data-current-locale={locale}
  data-spanish-path={spanishPath}
  data-english-path={englishPath}
></div>

<script>
  const prompt = document.getElementById("locale-prompt");

  if (prompt instanceof HTMLElement) {
    const currentLocale = prompt.dataset.currentLocale;
    const spanishPath = prompt.dataset.spanishPath;
    const englishPath = prompt.dataset.englishPath;
    const preferredLocale = window.localStorage.getItem("preferred-locale");

    if (!preferredLocale) {
      const browserLocales = navigator.languages?.length ? navigator.languages : [navigator.language];
      const browserPrefersSpanish = browserLocales.some((l) => l.toLowerCase().startsWith("es"));
      const browserLocale = browserPrefersSpanish ? "es" : "en";

      if (browserLocale !== currentLocale) {
        window.localStorage.setItem("preferred-locale", browserLocale);
        window.location.href = browserLocale === "es" ? spanishPath! : englishPath!;
      }
    }
  }
</script>

