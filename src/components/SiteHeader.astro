---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localizedPath, type Locale } from "../lib/i18n";

interface NavChild {
  href: string;
  label: string;
}

type NavItem =
  | { href: string; label: string; children?: never }
  | { href?: never; label: string; children: NavChild[] };

interface Props {
  navLanguage?: Locale;
  locale?: Locale;
}

const { navLanguage = "en", locale = navLanguage } = Astro.props;

const navItems: NavItem[] = navLanguage === "es"
  ? [
      { href: localizedPath("/", locale), label: "Portada" },
      { href: localizedPath("/blog/", locale), label: "Blog" },
      {
        label: "Intereses",
        href: localizedPath("/interests/", locale),
        children: [
          { href: localizedPath("/coding/", locale), label: "Programación" },
          { href: localizedPath("/literary-portfolio/", locale), label: "Literatura" },
          { href: localizedPath("/running/", locale), label: "Correr" },
        ],
      },
    ]
  : [
      { href: localizedPath("/", locale), label: "Home" },
      { href: localizedPath("/blog/", locale), label: "Blog" },
      {
        label: "Interests",
        href: localizedPath("/interests/", locale),
        children: [
          { href: localizedPath("/coding/", locale), label: "Programming" },
          { href: localizedPath("/literary-portfolio/", locale), label: "Literature" },
          { href: localizedPath("/running/", locale), label: "Running" },
        ],
      },
    ];

const closeLabel = navLanguage === "es" ? "Cerrar menú" : "Close menu";
const openLabel = navLanguage === "es" ? "Abrir menú" : "Open menu";

const currentPath = Astro.url.pathname;
const homePath = localizedPath("/", locale);
const showProfilePhoto = currentPath !== homePath;
const isPathActive = (href: string) => {
  if (href === homePath) {
    return currentPath === href;
  }

  const normalizedHref = href.endsWith("/") ? href : `${href}/`;
  return currentPath === normalizedHref || currentPath.startsWith(normalizedHref);
};
---

<header class="border-b border-ink/80 sticky top-0 bg-ink text-white z-50 shadow-lg">
  <div class="content-grid flex flex-wrap items-center justify-between gap-4 py-6">
    <a href={homePath} class="flex items-center gap-3 no-underline">
      {showProfilePhoto && (
        <img
          src="/images/profile/juan.jpeg"
          alt="Juan Ramírez"
          class="h-10 w-10 rounded-full border border-ink/15 object-cover"
          loading="lazy"
        />
      )}
      <span class="font-serif text-2xl tracking-tight font-bold uppercase text-white">JUAN RAMÍREZ</span>
    </a>
    <div class="flex items-center gap-4 md:gap-6 text-white">
    <nav aria-label={locale === "es" ? "Navegación principal" : "Main navigation"} class="hidden md:block">
      <ul class="flex gap-4 text-sm md:gap-6 md:text-base">
        {navItems.map((item) => {
          if (item.children) {
            // Marcar activo si estamos en la página del grupo o en una subpágina
            const isGroupActive = item.children.some((child) => isPathActive(child.href)) || (item.href && isPathActive(item.href));
            // Marcar deshabilitado si no estamos ni en la página del grupo ni en una subpágina
            const isGroupDisabled = !isGroupActive;
            return (
                <li
                  class={"relative group" + (isGroupActive ? " text-white font-bold underline underline-offset-4 decoration-accent" : isGroupDisabled ? " text-white/50" : "")}
                  tabIndex={0}
                  aria-haspopup="true"
                  aria-expanded={isGroupActive ? "true" : "false"}
                  onMouseEnter={e => {
                    window.__menuIsOver = true;
                    clearTimeout(window.__menuLeaveTimeout);
                    e.currentTarget.classList.add('hovering');
                  }}
                  onMouseLeave={e => {
                    window.__menuIsOver = false;
                    window.__menuLeaveTimeout = setTimeout(() => {
                      if (!window.__menuIsOver && !window.__submenuIsOver) {
                        e.currentTarget.classList.remove('hovering');
                      }
                    }, 700);
                  }}
                >
                <a href={item.href}
                  class="cursor-pointer select-none flex items-center gap-1 hover:underline focus:outline-none"
                  tabIndex={0}
                  onFocus={(e) => {
                    e.currentTarget.parentElement?.classList.add('focus-within');
                  }}
                  onBlur={(e) => {
                    setTimeout(() => {
                      e.currentTarget.parentElement?.classList.remove('focus-within');
                    }, 100);
                  }}
                >
                  {item.label}
                  <svg class="h-3 w-3 text-ink/60 group-hover:text-ink/80 transition" viewBox="0 0 12 12" fill="none"><path d="M6 8L10 4H2L6 8Z" fill="currentColor"/></svg>
                </a>
                {/* Mouse buffer to prevent accidental menu close */}
                <div
                  style="position:absolute;left:0;top:100%;height:24px;width:100%;z-index:39;"
                  onMouseEnter={e => {
                    window.__submenuIsOver = true;
                    clearTimeout(window.__menuLeaveTimeout);
                    e.currentTarget.parentElement?.classList.add('hovering');
                  }}
                  onMouseLeave={e => {
                    window.__submenuIsOver = false;
                    window.__menuLeaveTimeout = setTimeout(() => {
                      if (!window.__menuIsOver && !window.__submenuIsOver) {
                        e.currentTarget.parentElement?.classList.remove('hovering');
                      }
                    }, 700);
                  }}
                />
                <ul
                  class="absolute left-0 top-full z-40 mt-2 min-w-[10rem] rounded-md border border-ink/15 bg-white py-2 shadow-lg invisible opacity-0 group-hover:visible group-hover:opacity-100 group:focus-within:visible group:focus-within:opacity-100 group.hovering:visible group.hovering:opacity-100 transition-opacity duration-150"
                  onMouseEnter={e => {
                    window.__submenuIsOver = true;
                    clearTimeout(window.__menuLeaveTimeout);
                    e.currentTarget.parentElement?.classList.add('hovering');
                  }}
                  onMouseLeave={e => {
                    window.__submenuIsOver = false;
                    window.__menuLeaveTimeout = setTimeout(() => {
                      if (!window.__menuIsOver && !window.__submenuIsOver) {
                        e.currentTarget.parentElement?.classList.remove('hovering');
                      }
                    }, 700);
                  }}
                >
                {item.children.map((child) => (
                  <li key={child.href}>
                    <a
                      href={child.href}
                      class={
                        "block px-4 py-2 transition" +
                        (isPathActive(child.href)
                          ? " font-bold text-accent bg-ink/5 underline underline-offset-4"
                          : " text-ink/50 hover:text-accent hover:bg-ink/10")
                      }
                      aria-current={isPathActive(child.href) ? "page" : undefined}
                    >
                      {navLanguage === "en" && locale !== "es" && child.label === "Literature"
                        ? <><span>Literature</span><span class="ml-2 text-xs italic text-muted" style="white-space:nowrap;">&nbsp;(in&nbsp;Spanish)</span></>
                        : child.label}
                    </a>
                  </li>
                ))}
                </ul>
                </ul>
              <script is:inline>
              if (typeof window !== 'undefined') {
                window.__menuIsOver = false;
                window.__submenuIsOver = false;
              }
              </script>
              </li>
            );
            return (
              <li class="relative group">
                <span
                  class:list=[
                    "flex cursor-default select-none items-center gap-1",
                    isGroupActive ? "font-medium text-white" : "text-white/80 hover:text-white",
                  ]
                >
                  {item.label}
                  <svg
                    class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:rotate-180"
                    viewBox="0 0 12 12"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M6 8 1 3h10z" />
                  </svg>
                </span>
                <ul class="absolute left-1/2 top-full z-50 min-w-max -translate-x-1/2 pt-2 invisible opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100">
                  <div class="rounded-lg border border-ink/15 bg-[#fdfaf4] py-1 shadow-sm">
                    {item.children.map((child) => {
                      const isActive = isPathActive(child.href);
                      return (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              "block px-4 py-1.5",
                              isActive
                                ? "font-medium text-accent"
                                : "text-ink hover:text-accent",
                            ]}
                          >
                            {child.label}
                          </a>
                        </li>
                      );
                    })}
                  </div>
                </ul>
              </li>
            );
          }

          const isActive = isPathActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={{
                  "font-bold text-white underline underline-offset-4 decoration-accent": isActive,
                  "text-white/50 hover:text-white/80": !isActive,
                }}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="ml-2"><LanguageSwitcher locale={locale} /></div>

    <!-- Hamburger button (mobile only) -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex md:hidden items-center justify-center rounded-md p-2 text-white transition-colors hover:text-accent"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={openLabel}
    >
      <svg id="icon-menu" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="icon-close" class="h-6 w-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/15 bg-ink text-white"
    aria-label={locale === "es" ? "Navegación móvil" : "Mobile navigation"}
  >
    <nav class="content-grid py-4">
      <ul class="space-y-1">
        {navItems.map((item) => {
          if (item.children) {
            return (
              <li>
                <p class="px-2 pt-3 pb-1 text-xs uppercase tracking-widest text-white/50">{item.label}</p>
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          "block rounded-md px-3 py-2 text-base no-underline",
                          isPathActive(child.href)
                            ? "font-medium text-accent"
                            : "text-white/80 hover:text-accent",
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          }
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "block rounded-md px-3 py-2 text-base no-underline",
                  isPathActive(item.href)
                    ? "font-medium text-accent"
                    : "text-white/80 hover:text-accent",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script define:vars={{ openLabel, closeLabel }}>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.contains("hidden");
      menu.classList.toggle("hidden", !isOpen);
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
      iconMenu?.classList.toggle("hidden", isOpen);
      iconClose?.classList.toggle("hidden", !isOpen);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", openLabel);
        iconMenu?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
        toggle.focus();
      }
    });
  }
</script>
