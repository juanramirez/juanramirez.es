---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"portfolio">;
}

const { project } = Astro.props;
const isLiterary = project.data.category === "literary";
const isSpanish = project.data.lang === "es" || isLiterary;

const statusLabel =
  project.data.status === "in-development"
    ? (project.data.name === "NeuroLink"
        ? (isSpanish
            ? "🐌 En desarrollo (muy lento y muy temprano aún)"
            : "🐌 In (veeery slow and early) development")
        : (isSpanish
            ? "En desarrollo"
            : "In development"))
    : project.data.status === "published"
      ? isSpanish
        ? "Publicado"
        : "Published"
      : isSpanish
        ? "Planeado"
        : "Planned";

const statusColorClass = {
  "planned": "text-gray-600",
  "in-development": "text-yellow-600",
  "published": "text-green-600"
}[project.data.status];

const detailsLabel = isSpanish ? "Leer más" : "Read details";
const visitLabel = isLiterary ? "Visitar proyecto" : (isSpanish ? "Visitar proyecto en GitHub" : "Visit project on GitHub");
---

<li class="flex h-full flex-col gap-3 rounded-md border border-ink/15 bg-white/40 p-6">
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-3">
      {project.data.image && !isLiterary && (
        <img
          src={project.data.image}
          alt={`${project.data.name} logo`}
          class="h-8 w-8 shrink-0 object-contain"
          width={32}
          height={32}
          loading="lazy"
        />
      )}
      <h3 class="font-serif text-2xl leading-tight">
        <a href={`/portfolio/${project.slug}/`}>{project.data.name}</a>
      </h3>
    </div>
    {project.data.tags && project.data.tags.length > 0 && (
      <ul class="ml-2 flex max-w-[45%] flex-wrap justify-end gap-2 text-sm text-muted">
        {project.data.tags.map((tag) => (
          <li class="rounded-full border border-ink/20 px-3 py-1">{tag}</li>
        ))}
      </ul>
    )}
  </div>
  {project.data.subtitle && (
    <p class="text-sm italic text-muted">{project.data.subtitle}</p>
  )}
  <p class={`text-sm font-semibold ${statusColorClass}`}>
    {statusLabel}
  </p>
  <p class="text-muted" set:html={project.data.description} />
  {project.data.stack.length > 0 && (
    <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
      {project.data.stack.map((item) => (
        <li class="rounded-full border border-ink/20 px-3 py-1">{item}</li>
      ))}
    </ul>
  )}
  <p class="pt-1 text-sm">
    <a href={`/portfolio/${project.slug}/`}>{detailsLabel}</a>
  </p>
  {project.data.url && (
    <p class="text-sm">
      <a href={project.data.url} rel="noreferrer" target="_blank">
        {visitLabel}
      </a>
    </p>
  )}
</li>
