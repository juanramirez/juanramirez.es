---
interface Props {
  websiteId: string;
  pageId: string;
  heading?: string;
  language?: string;
}

const { websiteId, pageId, heading = "Comments", language } = Astro.props;
---

<section class="mt-10 border-t border-ink/15 pt-8">
  <h2 class="mb-4 font-serif text-2xl">{heading}</h2>
  <hyvor-talk-comments 
    website-id={websiteId} 
    page-id={pageId}
    {...(language ? { "page-language": language } : {})}
  ></hyvor-talk-comments>
  <script is:inline async type="module" src="https://talk.hyvor.com/embed/embed.js"></script>
  {language === "es" && (
    <script is:inline>
      const reactionLabels = {
        superb: "Excelente",
        love: "Me encanta",
        wow: "Asombro",
        sad: "Tristeza",
        laugh: "Risa",
        angry: "Enfado"
      };

      function translateReactions() {
        document.querySelectorAll("hyvor-talk-comments").forEach(el => {
          const root = el.shadowRoot;
          if (!root) return;

          root.querySelectorAll(".reaction").forEach(button => {
            const text = button.querySelector(".reaction-text");
            const img = button.querySelector("img");
            if (!text || !img) return;
            
            const src = img.src;
            for (const [key, label] of Object.entries(reactionLabels)) {
              if (src.includes(`/${key}.svg`)) {
                // Hide text visually but keep it in aria-label for accessibility
                text.style.display = "none";
                button.setAttribute("title", label);
                button.setAttribute("aria-label", label);
                break;
              }
            }
          });
        });
      }

      // Start checking after Hyvor loads
      let attempts = 0;
      const interval = setInterval(() => {
        translateReactions();
        attempts++;
        if (attempts > 30) clearInterval(interval); // Stop after 30 attempts (15 seconds)
      }, 500);
    </script>
  )}
</section>