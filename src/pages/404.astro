---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Juan Ramírez"
  description="The page you're looking for doesn't exist."
>
  <section class="max-w-3xl space-y-8 py-12 text-center sm:py-20">
    <p class="font-serif text-8xl font-bold text-accent/30 md:text-9xl">404</p>

    <div class="space-y-3">
      <h1 class="font-serif text-3xl md:text-4xl">Page not found</h1>
      <p class="text-lg text-muted">
        The page you're looking for doesn't exist or has been moved.
      </p>
    </div>

    <div class="flex flex-col items-center gap-3 text-base sm:flex-row sm:justify-center sm:gap-6">
      <a href="/">Go home</a>
      <span class="hidden text-muted sm:inline">·</span>
      <a href="/blog">Read the blog</a>
      <span class="hidden text-muted sm:inline">·</span>
      <a href="/portfolio">Explore my interests</a>
    </div>
  </section>
</BaseLayout>
