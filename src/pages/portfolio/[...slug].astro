---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HyvorComments from "../../components/HyvorComments.astro";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));

}

const { project } = Astro.props;
const { Content } = await render(project);
const hyvorWebsiteId = import.meta.env.PUBLIC_HYVOR_WEBSITE_ID;
const showComments = project.data.comments;
const isLiterary = project.data.category === "literary";
const statusLabel =
  project.data.status === "in-development"
    ? isLiterary
      ? "En desarrollo"
      : "In development"
    : project.data.status === "published"
      ? isLiterary
        ? "Publicado"
        : "Published"
      : isLiterary
        ? "Planeado"
        : "Planned";
const statusColorClass = {
  "planned": "text-gray-600",
  "in-development": "text-yellow-600",
  "published": "text-green-600"
}[project.data.status];
const repositoryLabel = isLiterary ? "Visitar proyecto" : "Visit project repository";
const backLabel = isLiterary ? "Volver al portfolio" : "Back to portfolio";
---

<BaseLayout
  title={`${project.data.name} | Portfolio | Juan Ramírez`}
  description={project.data.description}
  ogType="article"
>
  <article class="mx-auto max-w-3xl space-y-8">
    <header class="space-y-4 border-b border-ink/15 pb-6">
      {project.data.image && (
        <img
          src={project.data.image}
          alt={`${project.data.name} logo`}
          class="h-14 w-auto object-contain"
          loading="lazy"
        />
      )}
      <div>
        <h1 class="font-serif text-4xl leading-tight md:text-5xl">{project.data.name}</h1>
      </div>
      {project.data.subtitle && (
        <p class="text-lg italic text-muted">{project.data.subtitle}</p>
      )}
      <p class={`text-sm font-semibold ${statusColorClass}`}>
        {statusLabel}
      </p>
      <p class="text-lg text-muted" set:html={project.data.description} />
      {project.data.stack.length > 0 && (
        <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
          {project.data.stack.map((item) => (
            <li class="rounded-full border border-ink/20 px-3 py-1">{item}</li>
          ))}
        </ul>
      )}
      {project.data.tags && project.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 text-sm text-muted">
          {project.data.tags.map((tag) => (
            <li class="rounded-full border border-ink/20 px-3 py-1">{tag}</li>
          ))}
        </ul>
      )}
      {project.data.url && (
        <p class="text-sm">
          <a href={project.data.url} rel="noreferrer" target="_blank">
            {repositoryLabel}
          </a>
        </p>
      )}
    </header>

    <div class="prose-body">
      <Content />
    </div>

    {hyvorWebsiteId && showComments && (
      <HyvorComments websiteId={hyvorWebsiteId} pageId={`portfolio-${project.slug}`} />
    )}

    {import.meta.env.DEV && showComments && !hyvorWebsiteId && (
      <p class="rounded-md border border-dashed border-ink/25 p-4 text-sm text-muted">
        Comments are enabled for this project, but Hyvor is not configured. Set
        <code>PUBLIC_HYVOR_WEBSITE_ID</code> and restart the dev server.
      </p>
    )}

    <p class="text-sm">
      <a href="/portfolio">{backLabel}</a>
    </p>
  </article>
</BaseLayout>
