---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HyvorComments from "../../components/HyvorComments.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("portfolio")).filter((project) => !project.data.hidden);

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));

}

const { project } = Astro.props;
const { Content } = await render(project);
const hyvorWebsiteId = import.meta.env.PUBLIC_HYVOR_WEBSITE_ID;
const showComments = project.data.comments;
const isLiterary = project.data.category === "literary";
const statusLabel =
  project.data.status === "in-development"
    ? isLiterary
      ? "🐌 En desarrollo"
      : "🐌 In (veeery slow and early) development"
    : project.data.status === "published"
      ? isLiterary
        ? "Publicado"
        : "Published"
      : isLiterary
        ? "Planeado"
        : "Planned";
const statusColorClass = {
  "planned": "text-gray-600",
  "in-development": "text-yellow-600",
  "published": "text-green-600"
}[project.data.status];
const repositoryLabel = isLiterary ? "Visitar proyecto" : "Visit project repository";
const backLabel = isLiterary ? "Volver al porfolio" : "Back to portfolio";
const writtenDateLabel = isLiterary ? "Fecha de escritura" : "Written";
const publishedDateLabel = isLiterary ? "Fecha de publicacion" : "Published";
const sectionLabel = isLiterary ? "Literatura" : "Programming";
const sectionHref = isLiterary ? "/literary-portfolio/" : "/coding/";
const commentsHeading = isLiterary ? "Comentarios" : "Comments";
const commentsLanguage = isLiterary ? "es" : undefined;
const portfolioLabel = isLiterary ? "Porfolio" : "Portfolio";
const homeLabel = isLiterary ? "Portada" : "Home";
---

<BaseLayout
  title={`${project.data.name} | ${portfolioLabel} | Juan Ramírez`}
  description={project.data.description}
  ogType="article"
  navLanguage={isLiterary ? "es" : "en"}
>
  <article class="mx-auto max-w-3xl space-y-8">
          {/* Mostrar subtitle solo si no es in-development para evitar duplicado */}
          {project.data.subtitle && project.data.status !== "in-development" && (
            <p class="text-lg italic text-muted">{project.data.subtitle}</p>
          )}
          <p class={`text-sm font-semibold ${statusColorClass} flex items-center gap-1`}>
            {project.data.status === "in-development" && (
              <span aria-label="snail" title="slow development" class="inline-block align-middle">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1 opacity-80"><path d="M8.5 17a4.5 4.5 0 1 1 0-9h.25a.75.75 0 0 1 0 1.5H8.5a3 3 0 1 0 0 6h7a3 3 0 0 0 2.995-2.824l.005-.176V14a.75.75 0 0 1 1.5 0 4.5 4.5 0 0 1-4.5 4.5h-7Zm10-7.25a.75.75 0 0 1 .75.75v3a4.75 4.75 0 0 1-4.75 4.75h-7A4.75 4.75 0 0 1 2.75 13V10a.75.75 0 0 1 1.5 0v3a3.25 3.25 0 0 0 3.25 3.25h7A3.25 3.25 0 0 0 17.75 13v-3a.75.75 0 0 1 .75-.75Z"/></svg>
              </span>
            )}
            {statusLabel.replace(/^🐌 /, "")}
          </p>
        <li aria-hidden="true">/</li>
        <li class="text-ink/80">{project.data.name}</li>
      </ol>
    </nav>

    <header class="space-y-4 border-b border-ink/15 pb-6">
      {!isLiterary && project.data.image && (
        <img
          src={project.data.image}
          alt={`${project.data.name} logo`}
          class="h-14 w-auto object-contain"
          loading="lazy"
        />
      )}

      <div
        class:list={[
          isLiterary && project.data.image && "grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-start"
        ]}
      >
        <div class="space-y-4">
          <div>
            <h1 class="font-serif text-4xl leading-tight md:text-5xl">{project.data.name}</h1>
          </div>
          {/* Mostrar subtitle solo si no es in-development para evitar duplicado */}
          {project.data.subtitle && project.data.status !== "in-development" && (
            <p class="text-lg italic text-muted">{project.data.subtitle}</p>
          )}
          <p class={`text-sm font-semibold ${statusColorClass} flex items-center gap-1`}>
            {project.data.status === "in-development" && (
              <span aria-label="snail" title="slow development" class="inline-block align-middle">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1 opacity-80"><path d="M8.5 17a4.5 4.5 0 1 1 0-9h.25a.75.75 0 0 1 0 1.5H8.5a3 3 0 1 0 0 6h7a3 3 0 0 0 2.995-2.824l.005-.176V14a.75.75 0 0 1 1.5 0 4.5 4.5 0 0 1-4.5 4.5h-7Zm10-7.25a.75.75 0 0 1 .75.75v3a4.75 4.75 0 0 1-4.75 4.75h-7A4.75 4.75 0 0 1 2.75 13V10a.75.75 0 0 1 1.5 0v3a3.25 3.25 0 0 0 3.25 3.25h7A3.25 3.25 0 0 0 17.75 13v-3a.75.75 0 0 1 .75-.75Z"/></svg>
              </span>
            )}
            {statusLabel.replace(/^🐌 /, "")}
          </p>
          {(project.data.written_date || project.data.published_date) && (
            <ul class="space-y-1 text-sm text-muted">
              {project.data.written_date && (
                <li><strong>{writtenDateLabel}:</strong> {project.data.written_date}</li>
              )}
              {project.data.published_date && (
                <li><strong>{publishedDateLabel}:</strong> {project.data.published_date}</li>
              )}
            </ul>
          )}
          <p class="text-lg text-muted" set:html={project.data.description} />
          {project.data.stack.length > 0 && (
            <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
              {project.data.stack.map((item) => (
                <li class="rounded-full border border-ink/20 px-3 py-1">{item}</li>
              ))}
            </ul>
          )}
          {project.data.tags && project.data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-2 text-sm text-muted">
              {project.data.tags.map((tag) => (
                <li class="rounded-full border border-ink/20 px-3 py-1">{tag}</li>
              ))}
            </ul>
          )}
          {project.data.url && (
            <p class="text-sm">
              <a href={project.data.url} rel="noreferrer" target="_blank">
                {repositoryLabel}
              </a>
            </p>
          )}
        </div>

        {isLiterary && project.data.image && (
          <img
            src={project.data.image}
            alt={`Portada de ${project.data.name}`}
            class="h-auto w-full max-w-xs rounded-md border border-ink/15 object-cover shadow-sm md:justify-self-end"
            loading="lazy"
          />
        )}
      </div>
    </header>

    <div class="prose-body">
      <Content />
    </div>

    {hyvorWebsiteId && showComments && (
      <HyvorComments
        websiteId={hyvorWebsiteId}
        pageId={`portfolio-${project.slug}`}
        heading={commentsHeading}
        language={commentsLanguage}
      />
    )}

    {import.meta.env.DEV && showComments && !hyvorWebsiteId && (
      <p class="rounded-md border border-dashed border-ink/25 p-4 text-sm text-muted">
        {isLiterary ? "Los comentarios están activados para este proyecto, pero Hyvor no está configurado. Define " : "Comments are enabled for this project, but Hyvor is not configured. Set "}
        <code>PUBLIC_HYVOR_WEBSITE_ID</code>
        {isLiterary ? " y reinicia el servidor de desarrollo." : " and restart the dev server."}
      </p>
    )}

    <p class="text-sm">
      <a href="/portfolio">{backLabel}</a>
    </p>
  </article>
</BaseLayout>
