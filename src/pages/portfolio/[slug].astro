---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.name} | Portfolio | Juan Ramirez`}
  description={project.data.description}
  ogType="article"
>
  <article class="mx-auto max-w-3xl space-y-8">
    <header class="space-y-4 border-b border-ink/15 pb-6">
      {project.data.image && (
        <img
          src={project.data.image}
          alt={`${project.data.name} logo`}
          class="h-14 w-auto object-contain"
          loading="lazy"
        />
      )}
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-serif text-4xl leading-tight md:text-5xl">{project.data.name}</h1>
        <span class="rounded-full border border-ink/20 px-3 py-1 text-xs uppercase tracking-wide text-muted">
          {project.data.status === "in-development" ? "In development" : "Published"}
        </span>
      </div>
      <p class="text-lg text-muted">{project.data.description}</p>
      {project.data.stack.length > 0 && (
        <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
          {project.data.stack.map((item) => (
            <li class="rounded-full border border-ink/20 px-3 py-1">{item}</li>
          ))}
        </ul>
      )}
      {project.data.url && (
        <p class="text-sm">
          <a href={project.data.url} rel="noreferrer" target="_blank">
            Visit project repository
          </a>
        </p>
      )}
    </header>

    <div class="prose-body">
      <Content />
    </div>

    <p class="text-sm">
      <a href="/portfolio">Back to portfolio</a>
    </p>
  </article>
</BaseLayout>
