---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const allProjects = (await getCollection("portfolio")).sort((a, b) => {
  if (a.data.status === b.data.status) {
    return a.slug.localeCompare(b.slug);
  }

  return a.data.status === "in-development" ? -1 : 1;
});

const technical = allProjects.filter((p) => p.data.category === "technical");
const literary = allProjects.filter((p) => p.data.category === "literary");
---

<BaseLayout
  title="Portfolio | Juan Ramirez"
  description="Personal portfolio of technical and literary projects by Juan Ramirez."
>
  <section class="max-w-4xl space-y-16">
    <header class="space-y-2">
      <p class="text-sm uppercase tracking-[0.2em] text-muted">Portfolio</p>
      <h1 class="font-serif text-4xl md:text-5xl">Technical and literary projects</h1>
    </header>

    <div class="space-y-6">
      <h2 class="font-serif text-2xl">Technical</h2>
      {technical.length === 0 ? (
        <p class="rounded-md border border-dashed border-ink/25 p-6 text-muted">
          No technical projects yet. Add Markdown files with <code>category: technical</code> to <code>src/content/portfolio</code>.
        </p>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {technical.map((project) => <ProjectCard project={project} />)}
        </ul>
      )}
    </div>

    <div class="space-y-6">
      <h2 class="font-serif text-2xl">Literary</h2>
      {literary.length === 0 ? (
        <p class="rounded-md border border-dashed border-ink/25 p-6 text-muted">
          No literary projects yet. Add Markdown files with <code>category: literary</code> to <code>src/content/portfolio</code>.
        </p>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {literary.map((project) => <ProjectCard project={project} />)}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
