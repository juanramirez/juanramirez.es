---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allProjects = await getCollection("portfolio");
const technicalProjects = allProjects
  .filter((p) => p.data.category === "technical")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const literaryProjects = allProjects
  .filter((p) => p.data.category === "literary")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const technicalCount = technicalProjects.length;
const literaryCount = literaryProjects.length;
---

<BaseLayout
  title="Portfolio | Juan Ramírez"
  description="Personal portfolio of technical and literary projects by Juan Ramírez."
>
  <section class="max-w-4xl space-y-8">
    <header class="space-y-2">
      <h1 class="font-serif text-4xl md:text-5xl">Portfolio</h1>
      <p class="text-muted">Explore my work across different domains.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="group rounded-md border border-ink/15 bg-white/40 p-8 transition hover:bg-white/60 hover:shadow-sm">
        <a href="/coding-portfolio/" class="block no-underline decoration-transparent">
          <div class="space-y-2">
            <h2 class="flex items-center gap-3 font-serif text-2xl group-hover:text-ink/80">
              <img
                src="/images/icons/coding-portfolio.svg"
                alt=""
                aria-hidden="true"
                class="h-8 w-8 shrink-0"
                loading="lazy"
              />
              <span>Coding Portfolio</span>
            </h2>
            <p class="text-sm text-muted">{technicalCount} project{technicalCount === 1 ? "" : "s"}</p>
            <p class="text-sm text-muted">Technical and software projects.</p>
          </div>
          <p class="pt-4 text-sm text-ink/60 group-hover:text-ink/80">Explore →</p>
        </a>
        {technicalProjects.length > 0 && (
          <ul class="mt-4 space-y-1 text-sm text-muted">
            {technicalProjects.map((project) => (
              <li>
                <a href={`/portfolio/${project.slug}/`}>{project.data.name}</a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="group rounded-md border border-ink/15 bg-white/40 p-8 transition hover:bg-white/60 hover:shadow-sm">
        <a href="/literary-portfolio/" class="block no-underline decoration-transparent">
          <div class="space-y-2">
            <h2 class="flex items-center gap-3 font-serif text-2xl group-hover:text-ink/80">
              <img
                src="/images/icons/literary-portfolio.svg"
                alt=""
                aria-hidden="true"
                class="h-8 w-8 shrink-0"
                loading="lazy"
              />
              <span>Literary Portfolio</span>
            </h2>
            <p class="text-xs italic text-muted">(written in Spanish)</p>
            <p class="text-sm text-muted">{literaryCount} project{literaryCount === 1 ? "" : "s"}</p>
            <p class="text-sm text-muted">Creative and literary works.</p>
          </div>
          <p class="pt-4 text-sm text-ink/60 group-hover:text-ink/80">Explore →</p>
        </a>
        {literaryProjects.length > 0 && (
          <ul class="mt-4 space-y-1 text-sm text-muted">
            {literaryProjects.map((project) => (
              <li>
                <a href={`/portfolio/${project.slug}/`}>{project.data.name}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
