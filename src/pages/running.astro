---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoSlideshow from "../components/PhotoSlideshow.astro";

const historyPhotos = [
  { src: "/images/running/2010-04-11-maraton-malaga.jpeg", caption: "Maratón de Málaga 2010" },
  { src: "/images/running/2010-urbana.jpeg", caption: "Carrera Urbana Ciudad de Chiclana, Chiclana (Cádiz) 2010" },
  { src: "/images/running/2011-05-08-toruños.JPeG", caption: "Cross de los Toruños, Puerto Real (Cádiz) 2011" },
  { src: "/images/running/2011-05-21-urbana.JPeG", caption: "Carrera Urbana Ciudad de Chiclana, Chiclana (Cádiz) 2011" },
  { src: "/images/running/2012-11-09-universitaria-granada.jpeg", caption: "Carrera Universitaria de Granada, 2012" },
  { src: "/images/running/2013-04-28-maraton-madrid.jpeg", caption: "Maratón de Madrid 2013" },
  { src: "/images/running/2014-03-18-sanchicleti.jpeg", caption: "Carrera Chiclana - Sancti Petri, Chiclana (Cádiz) 2014" },
  { src: "/images/running/2014-06-15-norte-sur.jpeg", caption: "Carrera Norte-Sur, Madrid 2014" },
  { src: "/images/running/2014-10-14-media-playas-chiclana.jpeg", caption: "Media Maratón Playas de Chiclana, Chiclana (Cádiz) 2014" },
  { src: "/images/running/2014-12-08-maraton-malaga.jpeg", caption: "Maratón de Málaga 2014" },
  { src: "/images/running/2015-04-28-maraton-madrid.jpeg", caption: "Maratón de Madrid 2015" },
  { src: "/images/running/2015-05-12-media-granada.jpeg", caption: "Media Maratón de Granada 2015" },
  { src: "/images/running/2015-08-16-barrosaJPeG", caption: "Carrera Playa de la Barrosa, Chiclana (Cádiz) 2015" },
  { src: "/images/running/2015-12-08-media-madrid-blanca.jpeg", caption: "Media Maratón de Madrid 2015" },
  { src: "/images/running/2016-11-26-cross-san-roque.JPeG", caption: "Campeonato Andaluz de Cross, San Roque (Cádiz) 2016" },
  { src: "/images/running/2016-12-14-cross-hierro.jpeg", caption: "Cross Pinar de Hierro, Chiclana (Cádiz) 2016" },
  { src: "/images/running/2016-12-15-cross-cayendo.jpeg", caption: "Cross Pinar de la Barrosa, Chiclana (Cádiz) 2016" },
  { src: "/images/running/2017-02-20-maratón-sevilla.jpeg", caption: "Maratón de Sevilla 2017" },
  { src: "/images/running/2017-04-02-carrera-azul.jpeg", caption: "Carrera Azul por el Autismo, Santa Fe (Granada) 2017" },
  { src: "/images/running/2017-04-09-10k-novo-sancti-petri.jpeg", caption: "10K Novo Sancti Petri, Chiclana (Cádiz) 2017" },
  { src: "/images/running/2017-10-09-cross-colorado.jpeg", caption: "Cross El Colorado, Conil (Cádiz) 2017" },
];

const todayPhotos = [
  { src: "/images/posts/media-chiclana.jpeg", caption: "Media Maratón de Chiclana, abril 2026" },
  { src: "/images/posts/viamed-superacion.jpeg", caption: "Premio Viamed Superación, abril 2026" },
];

const records = [
  {
    distance: "1K",
    time: "2:57.7",
    race: "Test 1K",
    date: "14 Sep 2016",
    link: null,
    timeLink: null,
  },
  {
    distance: "1 mile",
    time: "5:01.5",
    race: "Milla de Suanzes",
    date: "27 Sep 2014",
    link: "https://atletismomadrid.com/index.php?Itemid=120&catid=28&id=3937&option=com_content&view=article",
    timeLink: null,
  },
  {
    distance: "5K",
    time: "17:46",
    race: "Carrera Azul del Autismo",
    date: "2 Apr 2017",
    link: null,
    timeLink: null,
  },
  {
    distance: "10K",
    time: "36:59",
    race: "Carrera Popular Memorial Padre Marcelino",
    date: "23 Apr 2017",
    link: "https://sportmaniacs.com/es/races/17-carrera-popular-memorial-padre-marcelino",
    timeLink: null,
  },
  {
        distance: "Half marathon",
        time: "1:21:00",
        race: "EDP Media Maratón de Sevilla",
        date: "29 Jan 2017",
        link: "https://sportmaniacs.com/en/races/edp-media-maraton-de-sevilla-2017",
        timeLink: null,
      },
      {
        distance: "Marathon",
        time: "2:55:30",
        race: "Zurich Maratón de Sevilla",
        date: "19 Feb 2017",
        link: "https://www.zurichmaratonsevilla.es/mse-clasificaciones-2017",
        timeLink: null,
      }
];
---

<BaseLayout
  title="Running | Juan Ramírez"
  description="Running activities and performance tracking by Juan Ramírez."
>
  <section class="max-w-4xl space-y-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink/80">Running</li>
      </ol>
    </nav>

    <header class="space-y-1">
      <h1 class="flex items-center gap-3 font-serif text-3xl md:text-4xl">
        <img
          src="/images/icons/running.svg"
          alt=""
          aria-hidden="true"
          class="h-10 w-10 shrink-0 md:h-11 md:w-11"
          loading="lazy"
        />
        <span>Running</span>
      </h1>
    </header>

    <div class="space-y-6">
      <h2 class="font-serif text-2xl md:text-3xl">My running history</h2>

      <PhotoSlideshow id="history" images={historyPhotos} />

      <div class="space-y-4 text-muted">
        <p>
          Running has been part of my life since my early twenties. I trained across the roads of
          Chiclana, Madrid and Ronda (wherever I've lived), competed regularly, and gradually
          worked down to times I am proud of —including a sub-37 10K and a 2:55 marathon,
          both set in early 2017.
        </p>
        <p>
          Three neurosurgeries in 2020 changed what my body can do and how I think about movement.
          I am now an adaptive runner — still going, on different terms and at a different pace, but
          still moving. The records below belong to the runner I was. I keep them here because they
          <i>are true</i>, and because the work they represent does not become less real just because the
          circumstances around it changed.
        </p>
      </div>

      <div class="space-y-3">
        <h3 class="font-serif text-lg md:text-xl text-muted">Personal records</h3>
        <ul class="divide-y divide-ink/10">
        {records.map((record) => (
          <li class="flex items-baseline gap-4 py-3 sm:gap-6">
            <span class="w-24 shrink-0 text-xs uppercase tracking-widest text-muted">
              {record.distance}
            </span>
            <span class="w-20 shrink-0 font-serif text-xl font-semibold tabular-nums">
              {record.timeLink ? (
                <a
                  href={record.timeLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent underline"
                >
                  {record.time}
                </a>
              ) : (
                record.time
              )}
            </span>
            <span class="min-w-0 text-sm text-muted">
              {record.link ? (
                <a
                  href={record.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent"
                >
                  {record.race}
                </a>
              ) : (
                record.race
              )}
              <span class="mx-1.5 opacity-40">·</span>
              {record.date}
            </span>
          </li>
        ))}
      </ul>
      </div>
    </div>

    <div class="space-y-6">
      <h2 class="font-serif text-2xl md:text-3xl">Running today</h2>

      <PhotoSlideshow id="today" images={todayPhotos} />

      <p class="text-muted">
        Since returning to racing in 2023, I compete as an adaptive runner — slower,
        with more planning, and with a lot more respect for what the body signals.
        These are the highlights since the surgeries.
      </p>
      <ul class="divide-y divide-ink/10">
        <li class="flex items-baseline gap-4 py-3 sm:gap-6">
          <span class="w-24 shrink-0 text-xs uppercase tracking-widest text-muted">Apr 2026</span>
          <span class="min-w-0 text-sm text-muted">
            <span class="font-medium text-ink">Chiclana Half-Marathon</span>
            <span class="mx-1.5 opacity-40">·</span>
            1:57:20
            <span class="mx-1.5 opacity-40">·</span>
            <a href="/blog/chiclana-half-marathon/" class="hover:text-accent">Read race report</a>
          </span>
        </li>
        <li class="flex items-baseline gap-4 py-3 sm:gap-6">
          <span class="w-24 shrink-0 text-xs uppercase tracking-widest text-muted">Apr 2026</span>
          <span class="min-w-0 text-sm text-muted">
            <span class="font-medium text-ink">Viamed Overcoming Prize</span>
            <span class="mx-1.5 opacity-40">·</span>
            Writing award for resilience and running
            <span class="mx-1.5 opacity-40">·</span>
            <a href="/blog/chiclana-half-marathon/" class="hover:text-accent">Read more</a>
          </span>
        </li>
        <li class="flex items-baseline gap-4 py-3 sm:gap-6">
          <span class="w-24 shrink-0 text-xs uppercase tracking-widest text-muted">Mar 2024</span>
          <span class="min-w-0 text-sm text-muted">
            <span class="font-medium text-ink">Chiclana Half-Marathon</span>
            <span class="mx-1.5 opacity-40">·</span>
            1:41:19
            <span class="mx-1.5 opacity-40">·</span>
            <a
              href="https://www.strava.com/activities/11177713071"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent"
            >View on Strava</a>
          </span>
        </li>
        <li class="flex items-baseline gap-4 py-3 sm:gap-6">
          <span class="w-24 shrink-0 text-xs uppercase tracking-widest text-muted">2023</span>
          <span class="min-w-0 text-sm text-muted">
            <span class="font-medium text-ink">Chiclana circuit races</span>
            <span class="mx-1.5 opacity-40">·</span>
            Return to competition after the surgeries
          </span>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
