---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const allProjects = (await getCollection("portfolio"))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => {
  if (a.data.status === b.data.status) {
    return a.slug.localeCompare(b.slug);
  }

  return a.data.status === "in-development" ? -1 : 1;
});

const technical = allProjects.filter((p) => p.data.category === "technical" && (p.data.lang === "en" || !p.data.lang));
---

<BaseLayout
  title="Programming | Juan Ramírez"
  description="Technical and software projects by Juan Ramírez."
>
  <section class="max-w-4xl space-y-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2 list-none">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/interests/">Interests</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink/80">Programming</li>
      </ol>
    </nav>

    <header class="space-y-1">
      <h1 class="flex items-center gap-3 font-serif text-3xl md:text-4xl">
        <img
          src="/images/icons/coding-portfolio.svg"
          alt=""
          aria-hidden="true"
          class="h-10 w-10 shrink-0 md:h-11 md:w-11"
          loading="lazy"
        />
        <span>Programming</span>
      </h1>
      <p class="text-sm text-muted">{technical.length} project{technical.length === 1 ? "" : "s"}</p>
    </header>

    <div class="text-muted space-y-4">
      <p>My passion for computers started very early on — programming in particular always fascinated me. The idea of building things that others could actually use and find useful.</p>
      <p>Gradually, that desire became a reality. I studied Computer Engineering in Granada, then started working, first at companies building software for the military sector.</p>
      <p>Shortly after, I joined <a href="https://en.wikipedia.org/wiki/Tuenti" target="_blank" rel="noopener">Tuenti</a> — that Spanish social network with a fairly teenage focus at first, which later became a mobile operator acquired by <a href="https://www.telefonica.com" target="_blank" rel="noopener">Telefónica</a>.</p>
      <p>After a leave of absence during which I worked at another company, <a href="https://influencity.com" target="_blank" rel="noopener">Influencity</a>, focused on influencer marketing, I returned to <a href="https://www.telefonica.com" target="_blank" rel="noopener">Telefónica</a>.</p>
      <p>Following my brain tumour surgery and rehabilitation, and after being recognised as permanently and totally disabled, I chose to take voluntary redundancy through a scheme the company launched in 2026, due to disagreements over how to adapt my role.</p>
      <p>I no longer work as a developer, though thanks to AI I have managed to do things like build and run this personal website. You can find my professional history on <a href="https://www.linkedin.com/in/juanramirez/" target="_blank" rel="noopener">LinkedIn</a>.</p>
    </div>

    <h2 class="font-serif text-2xl md:text-3xl">Project Portfolio</h2>

    {technical.length === 0 ? (
      <p class="rounded-md border border-dashed border-ink/25 p-6 text-muted">
        No coding projects yet. Add Markdown files with <code>category: technical</code> to <code>src/content/portfolio</code>.
      </p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2">
        {technical.map((project) => <ProjectCard project={project} />)}
      </ul>
    )}
  </section>
</BaseLayout>
