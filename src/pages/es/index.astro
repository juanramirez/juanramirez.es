---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Juan Ramírez | Desarrollador, escritor y corredor adaptado"
  description="Web personal de Juan Ramírez: reflexiones sobre daño cerebral adquirido, tecnología y los proyectos que dan forma a una vida en movimiento."
  locale="es"
>
  <section class="max-w-3xl space-y-7">
    <p class="text-sm uppercase tracking-[0.22em] text-muted">Presentación personal</p>
    <div class="flex flex-col items-center gap-5 sm:flex-row sm:items-center sm:gap-6 w-full">
      <img
        id="hero-image"
        src="/images/profile/juan.png"
        alt="Juan Ramírez"
        class="h-44 w-44 rounded-full border border-ink/15 object-cover transition-opacity duration-300 sm:h-56 sm:w-56"
        loading="lazy"
      />
      <h1 class="hero-title min-w-0 flex-1 font-serif leading-tight text-center sm:text-left w-full text-3xl md:text-5xl">
        <span class="hero-line">
          <span id="hero-intro" class="font-semibold" style="position:relative;display:inline-block;">
            <span class="hero-underline" style="position:absolute;left:0;bottom:-0.18em;width:0;height:0.13em;background:#111;border-radius:2px;transition:width 0.3s;"></span>
          </span>
        </span>
        <span id="hero-lines" class="hero-lines mt-5" aria-live="polite">
          <span class="hero-identity-line">
            <span id="hero-husband-prefix"></span><span id="hero-husband-insert" class="hero-added-word"></span><span id="hero-husband-base"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-writer-prefix"></span><span id="hero-writer-insert" class="hero-added-word"></span><span id="hero-writer-base"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-runner-prefix"></span><span id="hero-runner-base"></span><span id="hero-runner-insert" class="hero-added-word"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-developer-prefix"></span><span id="hero-developer-insert" class="hero-added-word"></span><span id="hero-developer-base"></span>
          </span>
          <span class="hero-identity-line hero-abi-line">
            <span id="hero-abi"></span><span id="abi-note" class="block text-sm text-gray-400 mt-2" style="display:none;"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-alive" class="text-[0.7rem] md:text-sm font-bold mt-6 block" style="color: #111;"></span>
          </span>
        </span>
      </h1>
    </div>
    <div id="intro-hidden" class="opacity-0 pointer-events-none transition-opacity duration-[2500ms]">
      <p class="text-lg leading-relaxed text-muted md:text-xl mb-5">
        En 2020, un tumor cerebral y tres neurocirugías cambiaron el rumbo de mi vida. Desde entonces, escribo sobre daño cerebral adquirido, tecnología y todo lo que considero verdadero y digno de compartir.
      </p>
      <p class="text-lg leading-relaxed text-muted md:text-xl">
        Esta web no trata de reducir mi identidad a una sola etiqueta. Es el lugar donde conviven mi trabajo técnico, mi escritura personal y mi proceso vital.
      </p>
      <div class="mt-7 text-base flex flex-col items-center gap-2 sm:flex-row sm:items-center sm:justify-start sm:gap-0">
        <a href="/es/blog/" class="block text-center sm:text-left">Leer el blog</a>
        <span class="hidden sm:inline mx-3 text-muted">·</span>
        <a href="/es/portfolio/" class="block text-center sm:text-left">Explorar mis intereses</a>
      </div>
    </div>
  </section>

  <style>
    .hero-title {
      display: flex;
      flex-direction: column;
      font-size: clamp(1.1rem, 2.8vw, 2.1rem);
      font-weight: 600;
    }

    .hero-line {
      display: block;
    }

    #hero-intro {
      white-space: nowrap;
      font-size: clamp(1rem, 7vw, 4.5rem);
      transition: font-size 11s cubic-bezier(.4,0,.2,1), opacity 1800ms ease, filter 11s cubic-bezier(.4,0,.2,1);
    }

    #hero-intro.shrink {
      font-size: clamp(1.1rem, 2.8vw, 2.1rem);
    }

    #hero-intro .hero-intro-name {
      color: inherit;
      transition: color 1800ms ease;
    }

    #hero-intro.is-dimmed {
      opacity: 0.34;
      filter: blur(1.8px);
    }

    #hero-intro.is-dimmed .hero-intro-name {
      color: #a79f8f;
    }

    .hero-underline {
      position: absolute;
      left: 0;
      bottom: -0.08em;
      width: 0;
      height: 0.13em;
      background: #111;
      border-radius: 2px;
      transition: width 0.3s;
      z-index: 1;
    }

    .hero-lines {
      display: grid;
      gap: 0.03em;
      margin-top: 0.18em;
      opacity: 0;
      overflow: hidden;
      transition: opacity 700ms 120ms ease;
    }

    .hero-lines.is-visible {
      opacity: 1;
    }

    .hero-identity-line {
      display: block;
      min-height: 1.02em;
      white-space: nowrap;
      font-size: clamp(0.85rem, 4.5vw, 2.1rem);
    }

    .hero-abi-line {
      font-size: clamp(0.85rem, 2.5vw, 1.7rem);
    }

    #hero-alive {
      font-size: clamp(1rem, 7vw, 4.5rem);
      font-weight: 700;
      display: inline-block;
      margin-top: 0.18em;
    }

    .hero-abi-line,
    .hero-added-word {
      color: #b14623;
    }

    .hero-edit-cursor {
      display: inline-block;
      color: currentColor;
      animation: blink 1.4s infinite;
    }

    @media (max-width: 420px) {
      .hero-title {
        font-size: clamp(1.25rem, 7vw, 1.75rem);
      }
    }

    @keyframes blink {
      0%, 49% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }
  </style>

  <script>
    const introTarget = document.querySelector("#hero-intro");
    const heroLines = document.querySelector("#hero-lines");
    const heroImage = document.querySelector("#hero-image");
    const defaultHeroImage = "/images/profile/juan.png";
    const introStartDelay = 250;
    const afterIntroPause = 1200;
    const introPrefix = "SOY";
    const introName = "JUAN RAMÍREZ";
    const introText = `${introPrefix} ${introName}`;
    const heroImages = [
      "/images/hero/abi-survivor.jpeg",
      "/images/hero/father-husband.jpeg",
      "/images/hero/writer.svg",
      "/images/hero/adapted-runner.png",
      "/images/hero/developer.png",
    ];
    const typingSpeed = 45;
    const linePause = 1100;
    const timers = [];

    const createCursor = () => {
      const cursor = document.createElement("span");
      cursor.className = "hero-edit-cursor";
      cursor.textContent = "_";
      return cursor;
    };

    const setHeroImage = (indexOrSrc) => {
      if (!heroImage) return;
      const nextImage = typeof indexOrSrc === "string" ? indexOrSrc : (heroImages[indexOrSrc] ?? heroImages[0]);
      if (heroImage.getAttribute("src") === nextImage) return;
      heroImage.classList.add("opacity-0");
      window.setTimeout(() => {
        heroImage.setAttribute("src", nextImage);
        heroImage.classList.remove("opacity-0");
      }, 120);
    };

    setHeroImage(defaultHeroImage);

    const delay = (ms) => new Promise((resolve) => { timers.push(window.setTimeout(resolve, ms)); });

    const placeCursor = (target, cursor) => { target.append(cursor); };

    const typeText = async (target, text, speed = typingSpeed, customCursor) => {
      const cursor = customCursor || createCursor();
      placeCursor(target, cursor);
      for (const character of text) {
        target.insertBefore(document.createTextNode(character), cursor);
        await delay(speed);
      }
      cursor.remove();
    };

    const startHeroSequence = async () => {
      if (!introTarget || !heroLines) return;

      await delay(introStartDelay);
      await typeText(introTarget, introText);
      await delay(afterIntroPause);

      introTarget.classList.add("shrink");
      introTarget.classList.add("is-dimmed");
      introTarget.style.fontSize = "clamp(1rem, 2vw, 1.5rem)";
      introTarget.style.opacity = 0.34;
      introTarget.style.filter = "blur(1.8px)";
      introTarget.innerHTML = `${introPrefix} <span class="hero-intro-name">${introName}</span><span class="hero-underline"></span>`;
      introTarget.style.fontSize = "clamp(1.2rem, 3vw, 2rem)";
      heroLines.classList.add("is-visible");

      const husbandPrefix = document.querySelector("#hero-husband-prefix");
      const husbandInsert = document.querySelector("#hero-husband-insert");
      const husbandBase = document.querySelector("#hero-husband-base");
      const writerInsert = document.querySelector("#hero-writer-insert");
      const writerPrefix = document.querySelector("#hero-writer-prefix");
      const writerBase = document.querySelector("#hero-writer-base");
      const runnerPrefix = document.querySelector("#hero-runner-prefix");
      const runnerInsert = document.querySelector("#hero-runner-insert");
      const runnerBase = document.querySelector("#hero-runner-base");
      const developerPrefix = document.querySelector("#hero-developer-prefix");
      const developerInsert = document.querySelector("#hero-developer-insert");
      const developerBase = document.querySelector("#hero-developer-base");
      const abiTarget = document.querySelector("#hero-abi");
      const abiNote = document.getElementById("abi-note");

      setHeroImage(1);
      await typeText(husbandPrefix, "Soy ");
      await typeText(husbandBase, "marido");
      await delay(linePause);

      setHeroImage(2);
      await typeText(writerPrefix, "Soy ");
      await typeText(writerBase, "escritor");
      await delay(linePause);

      setHeroImage(3);
      await typeText(runnerPrefix, "Soy ");
      await typeText(runnerBase, "corredor");
      await delay(linePause);

      setHeroImage(4);
      await typeText(developerPrefix, "Soy ");
      await typeText(developerBase, "desarrollador de software");
      await delay(linePause);

      if (abiTarget && runnerInsert && developerInsert && husbandInsert && writerInsert) {
        setHeroImage(0);
        runnerInsert.textContent = "";
        developerInsert.textContent = "";
        husbandInsert.textContent = "";
        writerInsert.textContent = "";
        abiTarget.textContent = "";

        const survivorSpan = document.createElement('span');
        abiTarget.appendChild(survivorSpan);
        await typeText(survivorSpan, "Soy superviviente de un tumor cerebral");
        await delay(900);

        setHeroImage("/images/hero/abi-diagnosis.png");
        const dcaSpan = document.createElement('span');
        dcaSpan.style.display = 'block';
        abiTarget.appendChild(dcaSpan);
        await typeText(dcaSpan, "Soy afectado por DCA*");

        if (abiNote) {
          abiNote.style.display = "block";
          const dcaText = '* DCA significa ';
          abiNote.textContent = '';
          for (let i = 0; i < dcaText.length; i++) {
            abiNote.textContent += dcaText[i];
            await new Promise(res => setTimeout(res, 22));
          }
          const link = document.createElement('a');
          link.href = 'https://fedace.org/que-es-el-dano-cerebral-adquirido.html';
          link.target = '_blank';
          link.rel = 'noopener';
          link.className = 'underline text-accent hover:text-accent';
          const linkText = 'Daño Cerebral Adquirido';
          link.textContent = '';
          abiNote.appendChild(link);
          for (let i = 0; i < linkText.length; i++) {
            link.textContent += linkText[i];
            await new Promise(res => setTimeout(res, 22));
          }
        }

        await delay(300);
        const aliveTarget = document.querySelector("#hero-alive");
        if (aliveTarget) {
          setHeroImage("/images/hero/alive.jpeg");
          await delay(linePause);

          const introEl = document.querySelector("#hero-intro");
          if (introEl) {
            introEl.classList.remove("is-dimmed");
            introEl.classList.remove("shrink");
            const duration = 350;
            const start = performance.now();
            const initialOpacity = 0.34;
            const finalOpacity = 1;
            const initialBlur = 1.8;
            const finalBlur = 0;
            const initialColor = [167, 159, 143];
            const finalColor = [17, 17, 17];
            const minFont = 22;
            const maxFont = Math.min(34, Math.round(window.innerWidth * 0.07));
            const nameSpan = introEl.querySelector('.hero-intro-name');
            const underline = introEl.querySelector('.hero-underline');
            function lerp(a, b, t) { return a + (b - a) * t; }
            function animateRestore(now) {
              const elapsed = Math.min(now - start, duration);
              const t = elapsed / duration;
              introEl.style.opacity = lerp(initialOpacity, finalOpacity, t);
              introEl.style.filter = `blur(${lerp(initialBlur, finalBlur, t)}px)`;
              introEl.style.fontSize = lerp(minFont, maxFont, t) + "px";
              const r = Math.round(lerp(initialColor[0], finalColor[0], t));
              const g = Math.round(lerp(initialColor[1], finalColor[1], t));
              const b = Math.round(lerp(initialColor[2], finalColor[2], t));
              if (nameSpan) nameSpan.style.color = `rgb(${r},${g},${b})`;
              if (underline) {
                const underlineProgress = Math.pow(Math.max(0, Math.min(t, 1)), 0.2);
                underline.style.width = `${Math.round(underlineProgress * 100)}%`;
              }
              if (elapsed < duration) {
                requestAnimationFrame(animateRestore);
              } else {
                introEl.style.opacity = finalOpacity;
                introEl.style.filter = `blur(${finalBlur}px)`;
                introEl.style.fontSize = "clamp(1rem, 7vw, 2.8rem)";
                if (nameSpan) nameSpan.style.color = `rgb(${finalColor[0]},${finalColor[1]},${finalColor[2]})`;
                if (underline) underline.style.width = "100%";
              }
            }
            requestAnimationFrame(animateRestore);
          }

          const texts = [
            { target: runnerInsert, text: "corredor adaptado " },
            { target: developerInsert, text: "ex-" },
            { target: husbandInsert, text: "padre y " },
            { target: writerInsert, text: "aún " },
            { target: aliveTarget, text: "SIGO VIVO" },
          ];
          const totalDuration = 2500;
          const speeds = texts.map(t => t.text.length ? Math.floor(totalDuration / t.text.length) : typingSpeed);
          await Promise.all(texts.map((t, i) => typeText(t.target, t.text, speeds[i], createCursor())));
        }
      }
    };

    startHeroSequence().then(() => {
      const intro = document.getElementById("intro-hidden");
      if (intro) {
        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            intro.classList.remove("opacity-0", "pointer-events-none");
            intro.classList.add("opacity-100");
            observer.disconnect();
          }
        }, { threshold: 0.1 });
        observer.observe(intro);
      }
    });

    window.addEventListener("pagehide", () => {
      timers.forEach((timer) => window.clearTimeout(timer));
    });
  </script>
</BaseLayout>
