---
import { getCollection, getEntryBySlug, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Remark42Comments from "../../../components/Remark42Comments.astro";


export async function getStaticPaths() {
  const projects = (await getCollection("portfolio")).filter((project) => !project.data.hidden && (project.data.lang === "es" || !project.data.lang));
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { slug: project.slug }
  }));
}

const { slug } = Astro.props;
// Buscar primero el entry en español, si no existe, usar el primero que coincida
// Buscar primero el entry en español, si no existe, usar el primero que coincida
const project = (await getCollection("portfolio")).find(
  (p) => p.slug === slug && (p.data.lang === "es" || !p.data.lang)
    && (p.id.endsWith(`/${slug}.es.md`) || p.id.endsWith(`/${slug}.md`))
);
if (!project) {
  return Astro.redirect('/404', 302);
}
const { Content } = await render(project);
const remark42Host = import.meta.env.PUBLIC_REMARK42_HOST;
const remark42SiteId = import.meta.env.PUBLIC_REMARK42_SITE_ID;
const showComments = project.data.comments;
const isLiterary = project.data.category === "literary";
const statusLabel = {
  planned: "Planeado",
  "in-development": "En desarrollo (muy lento y muy temprano)",
  published: "Publicado"
}[project.data.status];
const statusColorClass = {
  planned: "text-gray-600",
  "in-development": "text-yellow-600",
  published: "text-green-600"
}[project.data.status];
const sectionLabel = isLiterary ? "Literatura" : "Porfolio técnico";
const sectionHref = isLiterary ? "/es/literary-portfolio/" : "/es/coding/";
---

<BaseLayout
  title={`${project.data.name} | Porfolio | Juan Ramírez`}
  description={project.data.description}
  ogType="article"
  locale="es"
>
  <article class="mx-auto max-w-3xl space-y-8">
    <nav aria-label="Migas de pan" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2 list-none">
        <li><a href="/es/">Portada</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/es/portfolio/">Intereses</a></li>
        <li aria-hidden="true">/</li>
        {slug.includes("/") && (
          <>
            <li><a href={sectionHref}>{sectionLabel}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink/80">{project.data.name}</li>
          </>
        )}
        {!slug.includes("/") && (
          <li class="text-ink/80">{project.data.name}</li>
        )}
      </ol>
    </nav>

    <header class="space-y-4 border-b border-ink/15 pb-6">
      {!isLiterary && project.data.image && (
        <img src={project.data.image} alt={`${project.data.name} logo`} class="h-14 w-auto object-contain" width={56} height={56} loading="lazy" />
      )}

      <div class:list={[isLiterary && project.data.image && "grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-start"]}>
        <div class="space-y-4">
          <h1 class="font-serif text-4xl leading-tight md:text-5xl">{project.data.name}</h1>
          {/* Mostrar subtitle solo si no es in-development para evitar duplicado */}
          {project.data.subtitle && project.data.status !== "in-development" && (
            <p class="text-lg italic text-muted">{project.data.subtitle}</p>
          )}
          <p class={`text-sm font-semibold ${statusColorClass} flex items-center gap-1`}>
            {project.data.status === "in-development" && (
              <span aria-label="caracol" title="desarrollo lento" class="inline-block align-middle">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1 opacity-80"><path d="M8.5 17a4.5 4.5 0 1 1 0-9h.25a.75.75 0 0 1 0 1.5H8.5a3 3 0 1 0 0 6h7a3 3 0 0 0 2.995-2.824l.005-.176V14a.75.75 0 0 1 1.5 0 4.5 4.5 0 0 1-4.5 4.5h-7Zm10-7.25a.75.75 0 0 1 .75.75v3a4.75 4.75 0 0 1-4.75 4.75h-7A4.75 4.75 0 0 1 2.75 13V10a.75.75 0 0 1 1.5 0v3a3.25 3.25 0 0 0 3.25 3.25h7A3.25 3.25 0 0 0 17.75 13v-3a.75.75 0 0 1 .75-.75Z"/></svg>
              </span>
            )}
            {statusLabel}
          </p>
          <p class="text-lg text-muted" set:html={project.data.description} />
          {project.data.url && (
            <p class="text-sm">
              <a href={project.data.url} rel="noreferrer" target="_blank">{isLiterary ? "Visitar proyecto" : "Visitar proyecto en GitHub"}</a>
            </p>
          )}
        </div>

        {isLiterary && project.data.image && (
          <img
            src={project.data.image}
            alt={`Portada de ${project.data.name}`}
            class="h-auto w-full max-w-xs rounded-md border border-ink/15 object-cover shadow-sm md:justify-self-end"
            loading="lazy"
          />
        )}
      </div>
    </header>

    <div class="prose-body">
      <Content />
    </div>

    {remark42Host && showComments && (
      <Remark42Comments
        host={remark42Host}
        siteId={remark42SiteId}
        pageId={`es-portfolio-${project.slug}`}
        locale="es"
        heading="Comentarios"
      />
    )}

    <p class="text-sm">
      <a href="/es/portfolio/">Volver a intereses</a>
    </p>
  </article>
</BaseLayout>
