---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const literaryOrder = ["supersticion", "desmemorias", "mientras-duren-los-versos"];
const projects = (await getCollection("portfolio"))
  .filter((p) => !p.data.hidden && p.data.category === "literary")
  .sort((a, b) => {
    const aSlug = a.slug.split("/").pop() ?? a.slug;
    const bSlug = b.slug.split("/").pop() ?? b.slug;
    const aIndex = literaryOrder.indexOf(aSlug);
    const bIndex = literaryOrder.indexOf(bSlug);
    if (aIndex === -1 && bIndex === -1) return aSlug.localeCompare(bSlug);
    if (aIndex === -1) return 1;
    if (bIndex === -1) return -1;
    return aIndex - bIndex;
  });

const statusLabel = (status: string) => ({
  planned: "Planeado",
  "in-development": "En desarrollo",
  published: "Publicado"
}[status] ?? status);

const statusColorClass = (status: string) => ({
  planned: "text-gray-600",
  "in-development": "text-yellow-600",
  published: "text-green-600"
}[status] ?? "");
---

<BaseLayout
  title="Literatura | Juan Ramírez"
  description="Proyectos literarios de Juan Ramírez, escritos en español."
  locale="es"
>
  <section class="max-w-4xl space-y-6">
    <nav aria-label="Migas de pan" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/es/">Portada</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/es/interests/">Intereses</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink/80">Literatura</li>
      </ol>
    </nav>

    <header class="space-y-1">
      <h1 class="flex items-center gap-3 font-serif text-3xl md:text-4xl">
        <img src="/images/icons/literary-portfolio.svg" alt="" aria-hidden="true" class="h-10 w-10 shrink-0 md:h-11 md:w-11" loading="lazy" />
        <span>Literatura</span>
      </h1>
      <p class="text-sm text-muted">{projects.length} {projects.length === 1 ? "proyecto" : "proyectos"}</p>
    </header>

    <div class="text-muted space-y-4">
      <p>
        Una de mis grandes aficiones es la literatura. Me encanta leer y me gusta también escribir. Ya de adolescente, obtuve varios premios de poesía:
      </p>
      <ul class="text-muted space-y-2 list-disc list-outside ml-6">
        <li>1er premio en el XIV Certamen de Poesía Juvenil "Poeta García Gutiérrez" - Delegación de Juventud, Ayto. de Chiclana (Cádiz), 1999.</li>
        <li>3er premio de Poesía en el XIX Certamen Literario "Roquetas de Mar" - IES Sabinar (Roquetas de Mar, Almería), 2000.</li>
        <li>1er premio en el I Certamen Juvenil de Poesía "Juan Carlos Benítez" - Colegio San Felipe Neri (Cádiz), 2001.</li>
        <li>2o premio de Poesía en el XX Certamen Literario "Roquetas de Mar" - IES Sabinar, (Roquetas de Mar, Almería), 2001.</li>
        <li>1er premio en el certamen para la publicación de un cuadernillo literario - Delegación de Juventud, Ayto. de Chiclana (Cádiz), 2002.</li>
      </ul>
      <p>
        En la actualidad, y especialmente a partir de mi daño cerebral, estoy intentando retomar esta pasión.
      </p>
    </div>

    <h2 class="font-serif text-2xl md:text-3xl">Porfolio literario</h2>

    <ul class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <li class="flex h-full flex-col gap-3 rounded-md border border-ink/15 bg-white/40 p-6">
          <h3 class="font-serif text-2xl leading-tight">
            <a href={`/es/portfolio/${project.slug}/`}>{project.data.name}</a>
          </h3>
          {project.data.subtitle && <p class="text-sm italic text-muted">{project.data.subtitle}</p>}
          <p class={`text-sm font-semibold ${statusColorClass(project.data.status)}`}>
            {statusLabel(project.data.status)}
          </p>
          <p class="text-muted" set:html={project.data.description} />
          <p class="pt-1 text-sm"><a href={`/es/portfolio/${project.slug}/`}>Leer más</a></p>
          {project.data.url && (
            <p class="text-sm">
              <a href={project.data.url} rel="noreferrer" target="_blank">Visitar proyecto</a>
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
