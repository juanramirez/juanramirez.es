---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const allProjects = (await getCollection("portfolio")).filter((p) => !p.data.hidden);
const technicalProjects = allProjects
  .filter((p) => p.data.category === "technical")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const literaryProjects = allProjects
  .filter((p) => p.data.category === "literary")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="Intereses | Juan Ramírez"
  description="Intereses personales de Juan Ramírez en programación, literatura y correr."
  locale="es"
>
  <section class="max-w-4xl space-y-8">
    <nav aria-label="Migas de pan" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/es/">Portada</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink/80">Intereses</li>
      </ol>
    </nav>

    <header class="space-y-2">
      <h1 class="flex items-center gap-3 font-serif text-4xl md:text-5xl">
        <img src="/images/icons/portfolio-hub.svg" alt="" aria-hidden="true" class="h-10 w-10 shrink-0 md:h-11 md:w-11" loading="lazy" />
        <span>Intereses</span>
      </h1>
      <p class="text-muted">Explora mis intereses en distintas áreas.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="group rounded-md border border-ink/15 bg-white/40 p-8 transition hover:bg-white/60 hover:shadow-sm">
        <a href="/es/coding-portfolio/" class="block no-underline decoration-transparent">
          <h2 class="flex items-center gap-3 font-serif text-2xl group-hover:text-ink/80">
            <img src="/images/icons/coding-portfolio.svg" alt="" aria-hidden="true" class="h-8 w-8 shrink-0" loading="lazy" />
            <span>Programación</span>
          </h2>
          <p class="pt-2 text-sm text-muted">{technicalProjects.length} {technicalProjects.length === 1 ? "proyecto" : "proyectos"}</p>
          <p class="text-sm text-muted">Proyectos técnicos y de software.</p>
          <p class="pt-4 text-sm text-ink/60 group-hover:text-ink/80">Explorar portfolio técnico →</p>
        </a>
      </div>

      <div class="group rounded-md border border-ink/15 bg-white/40 p-8 transition hover:bg-white/60 hover:shadow-sm">
        <a href="/es/literary-portfolio/" class="block no-underline decoration-transparent">
          <h2 class="flex items-center gap-3 font-serif text-2xl group-hover:text-ink/80">
            <img src="/images/icons/literary-portfolio.svg" alt="" aria-hidden="true" class="h-8 w-8 shrink-0" loading="lazy" />
            <span>Literatura</span>
          </h2>
          <p class="pt-2 text-sm text-muted">{literaryProjects.length} {literaryProjects.length === 1 ? "proyecto" : "proyectos"}</p>
          <p class="text-sm text-muted">Obras creativas y literarias.</p>
          <p class="pt-4 text-sm text-ink/60 group-hover:text-ink/80">Explorar portfolio literario →</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
