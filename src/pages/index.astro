---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Juan Ramírez | Former Software Developer, Writer, and Adaptive Runner"
  description="Personal website of Juan Ramírez: thoughts on acquired brain injury, technology, and the projects that shape a life in motion."
>
  <section class="max-w-3xl space-y-7">
    <p class="text-sm uppercase tracking-[0.22em] text-muted">Personal introduction</p>
    <div class="flex flex-col items-center gap-5 sm:flex-row sm:items-center sm:gap-6 w-full">
      <img
        id="hero-image"
        src="/images/profile/juan.png"
        alt="Juan Ramírez"
        class="h-44 w-44 rounded-full border border-ink/15 object-cover transition-opacity duration-300 sm:h-56 sm:w-56"
        loading="lazy"
      />
      <h1 class="hero-title min-w-0 flex-1 font-serif leading-tight text-center sm:text-left w-full text-3xl md:text-5xl">
        <span class="hero-line">
          <span id="hero-intro" class="font-semibold" style="position:relative;display:inline-block;">
            <span class="hero-underline" style="position:absolute;left:0;bottom:-0.18em;width:0;height:0.13em;background:#111;border-radius:2px;transition:width 0.3s;"></span>
          </span>
        </span>
        <span id="hero-lines" class="hero-lines mt-5" aria-live="polite">
          <span class="hero-identity-line">
            <span id="hero-husband-prefix"></span><span id="hero-husband-insert" class="hero-added-word"></span><span id="hero-husband-base"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-writer-prefix"></span><span id="hero-writer-insert" class="hero-added-word"></span><span id="hero-writer-base"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-runner-prefix"></span><span id="hero-runner-insert" class="hero-added-word"></span><span id="hero-runner-base"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-developer-prefix"></span><span id="hero-developer-insert" class="hero-added-word"></span><span id="hero-developer-base"></span>
          </span>
          <span class="hero-identity-line hero-abi-line">
            <span id="hero-abi"></span><span id="abi-note" class="block text-sm text-gray-400 mt-2" style="display:none;"></span>
          </span>
          <span class="hero-identity-line">
            <span id="hero-alive" class="text-[0.7rem] md:text-sm font-bold mt-6 block" style="color: #111;"></span>
          </span>
        </span>
      </h1>
    </div>
    <div id="intro-hidden" class="opacity-0 pointer-events-none transition-opacity duration-[2500ms]">
      <p class="text-lg leading-relaxed text-muted md:text-xl mb-5">
        In 2020, three neurosurgeries changed the trajectory of my life. Since then, I have been writing about
        acquired brain injury, technology, and whatever else feels true and worth sharing.
      </p>
      <p class="text-lg leading-relaxed text-muted md:text-xl">
        This site is not about reducing identity to a single label. It is where my technical work, personal
        writing, and ongoing process coexist.
      </p>
      <div class="mt-7 text-base flex flex-col items-center gap-2 sm:flex-row sm:items-center sm:justify-start sm:gap-0">
        <a href="/blog" class="block text-center sm:text-left">Read my blog</a>
        <span class="hidden sm:inline mx-3 text-muted">·</span>
        <a href="/interests" class="block text-center sm:text-left">Explore my interests</a>
      </div>
    </div>
  </section>

  <script>
    // Mostrar intro al hacer scroll solo en móvil
    // El texto bajo el hero solo aparece tras la animación, en todos los tamaños

    const introTarget = document.querySelector("#hero-intro") as HTMLElement | null;
    const heroLines = document.querySelector("#hero-lines") as HTMLElement | null;
    const heroImage = document.querySelector("#hero-image") as HTMLImageElement | null;
    const defaultHeroImage = "/images/profile/juan.png";
    const introStartDelay = 250;
    const afterIntroPause = 1200; // Pausa tras 'I am Juan Ramírez'
    const introPrefix = "I'M";
    const introName = "JUAN RAMÍREZ";
    const introText = `${introPrefix} ${introName}`;

    const heroImages = [
      "/images/hero/abi-survivor.jpeg",
      "/images/hero/father-husband.jpeg",
      "/images/hero/writer.svg",
      "/images/hero/adaptive-runner.png",
      "/images/hero/developer.png",
    ];

    const typingSpeed = 45;
    const editTypingSpeed = 55;
    const linePause = 1100;
    const editPause = 620;
    const timers: number[] = [];
    // Crea un cursor independiente para cada animación paralela
    const createCursor = () => {
      const cursor = document.createElement("span");
      cursor.className = "hero-edit-cursor";
      cursor.textContent = "_";
      return cursor;
    };

    const setHeroImage = (indexOrSrc: number | string) => {
      if (!heroImage) {
        return;
      }

      const nextImage = typeof indexOrSrc === "string"
        ? indexOrSrc
        : (heroImages[indexOrSrc] ?? heroImages[0]);

      if (heroImage.getAttribute("src") === nextImage) {
        return;
      }

      heroImage.classList.add("opacity-0");

      window.setTimeout(() => {
        heroImage.setAttribute("src", nextImage);
        heroImage.classList.remove("opacity-0");
      }, 120);
    };

    setHeroImage(defaultHeroImage);

    const delay = (ms: number) =>
      new Promise<void>((resolve) => {
        timers.push(window.setTimeout(resolve, ms));
      });

    const placeCursor = (target: HTMLElement, cursor: HTMLElement) => {
      target.append(cursor);
    };

    const typeText = async (target: HTMLElement, text: string, speed = typingSpeed, customCursor?: HTMLElement) => {
      const cursor = customCursor || createCursor();
      placeCursor(target, cursor);
      for (const character of text) {
        target.insertBefore(document.createTextNode(character), cursor);
        await delay(speed);
      }
      cursor.remove();
    };

    const typeSegments = async (segments: { target: HTMLElement | null; text: string }[]) => {
      for (const segment of segments) {
        if (segment.target) {
          await typeText(segment.target, segment.text);
        }
      }
    };

    const startHeroSequence = async () => {
      if (!introTarget || !heroLines) return;

      await delay(introStartDelay);
      await typeText(introTarget, introText);
      // No eliminar cursor global, ya no se usa
      await delay(afterIntroPause);
      // Forzar tamaño pequeño y blur antes de mostrar líneas
      introTarget.classList.add("shrink");
      introTarget.classList.add("is-dimmed");
      introTarget.style.fontSize = "clamp(1rem, 2vw, 1.5rem)";
      introTarget.style.opacity = 0.34;
      introTarget.style.filter = "blur(1.8px)";
      introTarget.innerHTML = `${introPrefix} <span class=\"hero-intro-name\">${introName}</span><span class=\"hero-underline\"></span>`;
      // Ajustar tamaño final más pequeño
      introTarget.style.fontSize = "clamp(1.2rem, 3vw, 2rem)";
      heroLines.classList.add("is-visible");

      const husbandPrefix = document.querySelector("#hero-husband-prefix") as HTMLElement | null;
      const husbandInsert = document.querySelector("#hero-husband-insert") as HTMLElement | null;
      const husbandBase = document.querySelector("#hero-husband-base") as HTMLElement | null;
      const writerInsert = document.querySelector("#hero-writer-insert") as HTMLElement | null;
      const writerPrefix = document.querySelector("#hero-writer-prefix") as HTMLElement | null;
      const writerBase = document.querySelector("#hero-writer-base") as HTMLElement | null;
      const runnerPrefix = document.querySelector("#hero-runner-prefix") as HTMLElement | null;
      const runnerInsert = document.querySelector("#hero-runner-insert") as HTMLElement | null;
      const runnerBase = document.querySelector("#hero-runner-base") as HTMLElement | null;
      const developerPrefix = document.querySelector("#hero-developer-prefix") as HTMLElement | null;
      const developerInsert = document.querySelector("#hero-developer-insert") as HTMLElement | null;
      const developerBase = document.querySelector("#hero-developer-base") as HTMLElement | null;
      const abiTarget = document.querySelector("#hero-abi") as HTMLElement | null;
      const abiNote = document.getElementById("abi-note");

      // Escribir las líneas base con efecto typewriter
      setHeroImage(1);
      await typeText(husbandPrefix, "I'm a ");
      await typeText(husbandBase, "husband");
      await delay(linePause);

      setHeroImage(2);
      await typeText(writerPrefix, "I'm ");
      await typeText(writerBase, "a writer");
      await delay(linePause);

      setHeroImage(3);
      await typeText(runnerPrefix, "I'm a ");
      await typeText(runnerBase, "runner");
      await delay(linePause);

      setHeroImage(4);
      await typeText(developerPrefix, "I'm a ");
      await typeText(developerBase, "software developer");
      await delay(linePause);

      // ABI primero, luego añadidos y 'I'm still alive' en paralelo
      if (abiTarget && runnerInsert && developerInsert && husbandInsert && writerInsert) {
        // Mostrar primero 'I'm a brain tumor survivor' con efecto typewriter
        setHeroImage(0); // Imagen actual para survivor
        runnerInsert.textContent = "";
        developerInsert.textContent = "";
        husbandInsert.textContent = "";
        writerInsert.textContent = "";
        abiTarget.textContent = "";
        // Creamos un span para 'I'm a brain tumor survivor'
        const survivorSpan = document.createElement('span');
        abiTarget.appendChild(survivorSpan);
        await typeText(survivorSpan, "I'm a brain tumor survivor");
        await delay(900);
        // Ahora mostrar 'I have an ABI*' debajo, con otra imagen
        setHeroImage("/images/hero/abi-diagnosis.png");
        const abiSpan = document.createElement('span');
        abiSpan.style.display = 'block';
        abiTarget.appendChild(abiSpan);
        await typeText(abiSpan, "I have an ABI*");
        if (abiNote) {
          abiNote.style.display = "block";
          // Typewriter para el asterisco y explicación
          const abiType = '* ABI stands for ';
          abiNote.textContent = '';
          for (let i = 0; i < abiType.length; i++) {
            abiNote.textContent += abiType[i];
            await new Promise(res => setTimeout(res, 22));
          }
          // Ahora el enlace, también con efecto máquina de escribir
          const link = document.createElement('a');
          link.href = 'https://en.wikipedia.org/wiki/Acquired_brain_injury';
          link.target = '_blank';
          link.rel = 'noopener';
          link.className = 'underline text-accent hover:text-accent';
          const linkText = 'Acquired Brain Injury';
          link.textContent = '';
          abiNote.appendChild(link);
          for (let i = 0; i < linkText.length; i++) {
            link.textContent += linkText[i];
            await new Promise(res => setTimeout(res, 22));
          }
        }
        await delay(300);
        // Ahora añadidos y 'I'm still alive' en paralelo
        const aliveTarget = document.querySelector("#hero-alive") as HTMLElement | null;
        if (aliveTarget) {
          setHeroImage("/images/hero/alive.jpeg");
          await delay(linePause);
          // Efecto progresivo para restaurar el color de 'I am Juan Ramírez' mientras se escribe 'I'm still alive'
          const introTarget = document.querySelector("#hero-intro");
          if (introTarget) {
            // Quitar clases de difuminado si existen
            introTarget.classList.remove("is-dimmed");
            introTarget.classList.remove("shrink");
            // Animar color, opacidad, blur y font-size progresivamente (más rápido y menos grande)
            const duration = 350; // antes 1200
            const start = performance.now();
            const initialOpacity = 0.34;
            const finalOpacity = 1;
            const initialBlur = 1.8;
            const finalBlur = 0;
            const initialColor = [167, 159, 143]; // #a79f8f
            const finalColor = [17, 17, 17]; // #111
            const minFont = 22; // px (aprox clamp(1.1rem, 2.8vw, 2.1rem))
            const maxFont = Math.min(34, Math.round(window.innerWidth * 0.07));
            const nameSpan = introTarget.querySelector('.hero-intro-name');
            function lerp(a, b, t) { return a + (b - a) * t; }
            const underline = introTarget.querySelector('.hero-underline');
            function animateRestore(now) {
              const elapsed = Math.min(now - start, duration);
              const t = elapsed / duration;
              const opacity = lerp(initialOpacity, finalOpacity, t);
              const blur = lerp(initialBlur, finalBlur, t);
              const fontSize = lerp(minFont, maxFont, t);
              introTarget.style.opacity = opacity;
              introTarget.style.filter = `blur(${blur}px)`;
              introTarget.style.fontSize = fontSize + "px";
              const r = Math.round(lerp(initialColor[0], finalColor[0], t));
              const g = Math.round(lerp(initialColor[1], finalColor[1], t));
              const b = Math.round(lerp(initialColor[2], finalColor[2], t));
              if (nameSpan) nameSpan.style.color = `rgb(${r},${g},${b})`;
              // El subrayado crece desde el principio pero mucho más lento (t^0.2)
              if (underline) {
                const underlineProgress = Math.pow(Math.max(0, Math.min(t, 1)), 0.2);
                underline.style.width = `${Math.round(underlineProgress * 100)}%`;
              }
              if (elapsed < duration) {
                requestAnimationFrame(animateRestore);
              } else {
                introTarget.style.opacity = finalOpacity;
                introTarget.style.filter = `blur(${finalBlur}px)`;
                introTarget.style.fontSize = "clamp(1rem, 7vw, 2.8rem)";
                if (nameSpan) nameSpan.style.color = `rgb(${finalColor[0]},${finalColor[1]},${finalColor[2]})`;
                if (underline) underline.style.width = "100%";
              }
            }
            requestAnimationFrame(animateRestore);
          }
          const texts = [
            { target: runnerInsert, text: "adaptive " },
            { target: developerInsert, text: "former " },
            { target: husbandInsert, text: "father and " },
            { target: writerInsert, text: "still " },
            { target: aliveTarget, text: "I'm still alive" },
          ];
          const totalDuration = 2500;
          const speeds = texts.map(t => t.text.length ? Math.floor(totalDuration / t.text.length) : typingSpeed);
          await Promise.all(texts.map((t, i) => typeText(t.target, t.text, speeds[i], createCursor())));
        }
      }
    };

    startHeroSequence().then(() => {
      // Mostrar intro bajo el hero solo cuando la animación ha terminado
      const intro = document.getElementById("intro-hidden");
      if (intro) {
        intro.classList.remove("opacity-0", "pointer-events-none");
        intro.classList.add("opacity-100");
      }
    });

    window.addEventListener("pagehide", () => {
      timers.forEach((timer) => window.clearTimeout(timer));
    });
  </script>

  <style>
    .hero-title {
          .hero-underline {
            position: absolute;
            left: 0;
            bottom: -0.08em; /* Un poco más separado del texto */
            width: 0;
            height: 0.13em;
            background: #111;
            border-radius: 2px;
            transition: width 0.3s;
            z-index: 1;
          }
      display: flex;
      flex-direction: column;
      font-size: clamp(1.1rem, 2.8vw, 2.1rem);
      font-weight: 600; /* semibold para todo el título */
    }

    .hero-line {
      display: block;
    }

    #hero-intro {
      white-space: nowrap;
      font-size: clamp(1rem, 7vw, 4.5rem);
      transition: font-size 11s cubic-bezier(.4,0,.2,1), opacity 1800ms ease, filter 11s cubic-bezier(.4,0,.2,1);
    }

    #hero-intro.shrink {
      font-size: clamp(1.1rem, 2.8vw, 2.1rem);
    }

    #hero-intro .hero-intro-name {
      color: inherit;
      transition: color 1800ms ease;
    }

    #hero-intro.is-dimmed {
      opacity: 0.34;
      filter: blur(1.8px);
    }

    #hero-intro.is-dimmed .hero-intro-name {
      color: #a79f8f;
    }

    .hero-lines {
      display: grid;
      gap: 0.03em;
      margin-top: 0.18em;
      opacity: 0;
      overflow: hidden;
      transition: opacity 700ms 120ms ease;
    }

    .hero-lines.is-visible {
      opacity: 1;
    }

    .hero-identity-line {
      display: block;
      min-height: 1.02em;
      white-space: nowrap;
      font-size: clamp(0.85rem, 4.5vw, 2.1rem);
    }

    #hero-alive {
      font-size: clamp(1rem, 7vw, 4.5rem);
      font-weight: 700; /* bold solo para 'I'm still alive' */
      display: inline-block;
      margin-top: 0.18em;
    }

    .hero-abi-line,
    .hero-added-word {
      color: #b14623;
    }

    .hero-edit-cursor {
      display: inline-block;
      color: currentColor;
      animation: blink 1.4s infinite;
    }

    @media (max-width: 420px) {
      .hero-title {
        font-size: clamp(1.25rem, 7vw, 1.75rem);
      }
    }

    @keyframes blink {
      0%, 49% {
        opacity: 1;
      }
      50%, 100% {
        opacity: 0;
      }
    }
  </style>
</BaseLayout>
