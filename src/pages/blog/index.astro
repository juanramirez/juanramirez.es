---
import { getCollection } from "astro:content";
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const toTagSlug = (tag: string) =>
  tag
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
---

<BaseLayout
  title="Blog | Juan Ramírez"
  description="Articles by Juan Ramírez on acquired brain injury, technology, and personal reflections."
>
  <section class="max-w-3xl space-y-8">
    <header>
      <h1 class="flex items-center gap-3 font-serif text-3xl md:text-4xl">
        <img
          src="/images/icons/blog-section-newspaper.svg"
          alt=""
          aria-hidden="true"
          class="h-10 w-10 shrink-0 md:h-11 md:w-11"
          loading="lazy"
        />
        <span>Blog</span>
      </h1>
    </header>

    {
      posts.length === 0 ? (
        <p class="rounded-md border border-dashed border-ink/25 p-6 text-muted">
          No posts yet. Add Markdown files to <code>src/content/blog</code>.
        </p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => {
            const postImage =
              post.data.featured_image ?? post.data["featured-image"] ?? post.data.image;

            return (
              <li class="space-y-3 border-b border-ink/10 pb-6">
                <p class="text-sm text-muted">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric"
                    })}
                  </time>
                  {" "}· by {post.data.author}
                </p>
                <h2 class="font-serif text-2xl font-semibold leading-tight">
                  <a href={`/blog/${post.slug}/`} set:html={post.data.title}></a>
                </h2>

                {postImage ? (
                  <div class="grid gap-4 md:grid-cols-9 md:items-start">
                    <div class="md:col-span-4">
                      <img
                        src={postImage}
                        alt={`Featured image for ${post.data.title}`}
                        class="h-full w-full rounded-md border border-ink/15 object-cover"
                        loading="lazy"
                      />
                    </div>
                    <p class="text-muted md:col-span-5" set:html={marked.parseInline(post.data.excerpt)} />
                  </div>
                ) : (
                  <p class="text-muted" set:html={marked.parseInline(post.data.excerpt)} />
                )}

                {post.data.tags.length > 0 && (
                  <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
                    {post.data.tags.map((tag) => (
                      <li>
                        <a
                          href={`/blog/tag/${toTagSlug(tag)}/`}
                          class="inline-block rounded-full border border-ink/20 px-3 py-1 no-underline decoration-transparent"
                        >
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</BaseLayout>
