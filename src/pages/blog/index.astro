---
import { getCollection } from "astro:content";
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Blog | Juan Ramirez"
  description="Articles by Juan Ramirez on acquired brain injury, technology, and personal reflections."
>
  <section class="max-w-3xl space-y-8">
    <header class="space-y-2">
      <p class="text-sm uppercase tracking-[0.2em] text-muted">Blog</p>
      <h1 class="font-serif text-4xl md:text-5xl">Writing in public</h1>
    </header>

    {
      posts.length === 0 ? (
        <p class="rounded-md border border-dashed border-ink/25 p-6 text-muted">
          No posts yet. Add Markdown files to <code>src/content/blog</code>.
        </p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => (
            <li class="space-y-2 border-b border-ink/10 pb-6">
              <p class="text-sm text-muted">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric"
                  })}
                </time>
              </p>
              <h2 class="font-serif text-2xl leading-tight">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="text-muted" set:html={marked.parseInline(post.data.excerpt)} />
              {post.data.tags.length > 0 && (
                <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
                  {post.data.tags.map((tag) => (
                    <li class="rounded-full border border-ink/20 px-3 py-1">{tag}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
