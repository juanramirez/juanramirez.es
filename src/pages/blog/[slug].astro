---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Juan Ramirez`} description={post.data.excerpt} ogType="article">
  <article class="mx-auto max-w-3xl">
    <header class="mb-8 space-y-3 border-b border-ink/15 pb-6">
      <p class="text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </time>
      </p>
      <h1 class="font-serif text-4xl leading-tight md:text-5xl">{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
          {post.data.tags.map((tag) => (
            <li class="rounded-full border border-ink/20 px-3 py-1">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose-body">
      <Content />
    </div>
  </article>
</BaseLayout>
