---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Remark42Comments from "../../components/Remark42Comments.astro";

import { getLocalizedContentSlug, toTagSlug } from "../../lib/i18n";
import { readingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const locale = "en";
  const posts = (await getCollection("blog")).filter((post) => post.data.lang === locale);

  return posts.map((post) => ({
    params: { slug: getLocalizedContentSlug(post.slug, locale) },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const remark42Host = import.meta.env.PUBLIC_REMARK42_HOST ?? "https://remark42-production-7145.up.railway.app";
const remark42SiteId = import.meta.env.PUBLIC_REMARK42_SITE_ID ?? "juan-ramirez.es";
const showComments = post.data.comments;
const postReadingTime = readingTime(post.body ?? "");

---

<BaseLayout title={`${post.data.title} | Juan Ramírez`} description={post.data.excerpt} ogType="article" locale="en">
  <article class="mx-auto max-w-3xl">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog/">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink/80">{post.data.title}</li>
      </ol>
    </nav>

    <header class="mb-8 space-y-3 border-b border-ink/15 pb-6">
      <p class="text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </time>
        {" "}· by {post.data.author}
        {" "}· {postReadingTime}
      </p>
      <h1 class="font-serif text-4xl leading-tight md:text-5xl" set:html={post.data.title}></h1>
      {post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
          {post.data.tags.map((tag) => (
            <li>
              <a
                href={`/blog/tag/${toTagSlug(tag)}/`}
                class="inline-block rounded-full border border-ink/20 px-3 py-1 no-underline decoration-transparent"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {(post.data.featured_image ?? post.data["featured-image"] ?? post.data.image) && (
      <img
        src={post.data.featured_image ?? post.data["featured-image"] ?? post.data.image}
        alt=""
        class="mb-8 w-full rounded-lg object-cover"
        loading="eager"
      />
    )}

    <div class="prose-body">
      <Content />
    </div>

    {showComments && (
      <Remark42Comments
        host={remark42Host}
        siteId={remark42SiteId}
        pageId={post.slug}
      />
    )}
  </article>
</BaseLayout>
