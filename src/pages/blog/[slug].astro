---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HyvorComments from "../../components/HyvorComments.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const hyvorWebsiteId = import.meta.env.PUBLIC_HYVOR_WEBSITE_ID;
const showComments = post.data.comments;

const toTagSlug = (tag: string) =>
  tag
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
---

<BaseLayout title={`${post.data.title} | Juan Ramírez`} description={post.data.excerpt} ogType="article">
  <article class="mx-auto max-w-3xl">
    <header class="mb-8 space-y-3 border-b border-ink/15 pb-6">
      <p class="text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </time>
        {" "}· by {post.data.author}
      </p>
      <h1 class="font-serif text-4xl leading-tight md:text-5xl" set:html={post.data.title}></h1>
      {post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
          {post.data.tags.map((tag) => (
            <li>
              <a
                href={`/blog/tag/${toTagSlug(tag)}/`}
                class="inline-block rounded-full border border-ink/20 px-3 py-1 no-underline decoration-transparent"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {(post.data.featured_image ?? post.data["featured-image"] ?? post.data.image) && (
      <img
        src={post.data.featured_image ?? post.data["featured-image"] ?? post.data.image}
        alt=""
        class="mb-8 w-full rounded-lg object-cover"
        loading="eager"
      />
    )}

    <div class="prose-body">
      <Content />
    </div>

    {hyvorWebsiteId && showComments && <HyvorComments websiteId={hyvorWebsiteId} pageId={post.slug} />}

    {import.meta.env.DEV && showComments && !hyvorWebsiteId && (
      <p class="mt-10 rounded-md border border-dashed border-ink/25 p-4 text-sm text-muted">
        Comments are enabled for this post, but Hyvor is not configured. Set
        <code>PUBLIC_HYVOR_WEBSITE_ID</code> and restart the dev server.
      </p>
    )}
  </article>
</BaseLayout>
