---
import { getCollection } from "astro:content";
import { marked } from "marked";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalizedContentSlug, toTagSlug } from "../../../lib/i18n";

interface PostEntry {
  slug: string;
  data: {
    title: string;
    date: Date;
    author: string;
    excerpt: string;
    tags: string[];
    image?: string;
    featured_image?: string;
    "featured-image"?: string;
  };
}

export async function getStaticPaths() {
  const locale = "en";
  const allPosts = (await getCollection("blog"))
    .filter((post) => post.data.lang === locale)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const tagBuckets = new Map<string, { label: string; posts: PostEntry[] }>();

  for (const post of allPosts) {
    for (const tag of post.data.tags) {
      const slug = toTagSlug(tag);

      if (!slug) {
        continue;
      }

      if (!tagBuckets.has(slug)) {
        tagBuckets.set(slug, { label: tag, posts: [] });
      }

      tagBuckets.get(slug)!.posts.push(post as PostEntry);
    }
  }

  return Array.from(tagBuckets.entries()).map(([slug, bucket]) => ({
    params: { tag: slug },
    props: {
      tagLabel: bucket.label,
      posts: bucket.posts
    }
  }));
}

const { tagLabel, posts } = Astro.props;
const locale = "en";
---

<BaseLayout
  title={`Blog | Tag: ${tagLabel} | Juan Ramírez`}
  description={`Blog posts tagged with ${tagLabel}.`}
>
  <section class="max-w-3xl space-y-8">
    <header class="space-y-3">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink/80">Tag: {tagLabel}</li>
        </ol>
      </nav>
      <h1 class="font-serif text-3xl md:text-4xl">Tag: {tagLabel}</h1>
    </header>

    {
      posts.length === 0 ? (
        <p class="rounded-md border border-dashed border-ink/25 p-6 text-muted">
          No posts found for this tag.
        </p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => {
            const postImage =
              post.data.featured_image ?? post.data["featured-image"] ?? post.data.image;

            return (
              <li class="space-y-3 border-b border-ink/10 pb-6">
                <p class="text-sm text-muted">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric"
                    })}
                  </time>
                  {" "}· by {post.data.author}
                </p>
                <h2 class="font-serif text-2xl font-semibold leading-tight">
                  <a href={`/blog/${getLocalizedContentSlug(post.slug, locale)}/`} set:html={post.data.title}></a>
                </h2>

                {postImage ? (
                  <div class="grid gap-4 md:grid-cols-9 md:items-start">
                    <div class="md:col-span-4">
                      <img
                        src={postImage}
                        alt={`Featured image for ${post.data.title}`}
                        class="h-full w-full rounded-md border border-ink/15 object-cover"
                        loading="lazy"
                      />
                    </div>
                    <p class="text-muted md:col-span-5" set:html={marked.parseInline(post.data.excerpt)} />
                  </div>
                ) : (
                  <p class="text-muted" set:html={marked.parseInline(post.data.excerpt)} />
                )}

                {post.data.tags.length > 0 && (
                  <ul class="flex flex-wrap gap-2 pt-1 text-sm text-muted">
                    {post.data.tags.map((tag) => (
                      <li>
                        <a
                          href={`/blog/tag/${toTagSlug(tag)}/`}
                          class="inline-block rounded-full border border-ink/20 px-3 py-1 no-underline decoration-transparent"
                        >
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</BaseLayout>
